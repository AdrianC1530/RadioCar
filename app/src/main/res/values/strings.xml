    <string name="home_guard">Protección</string>
    <string name="home_settings_hint">Ve a Apps → ⚙ → «App de inicio» y elige RadioCar</string>
    <string name="guard_label">RadioCar · protección de inicio</string>
    <string name="guard_description">Trae RadioCar al frente cuando aparece el launcher de fábrica de la radio (al encender o al pulsar Inicio). Solo detecta cambios de pantalla; no lee lo que hay en ella.</string>
    <string name="guard_banner">Activa la protección de inicio para que RadioCar quede fijo</string>

